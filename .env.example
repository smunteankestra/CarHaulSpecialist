# Telegram bot used for the website chat and admin notifications.
# Create the bot with @BotFather, then put the token and destination chat id here.
# Local dev: copy these into .dev.vars (Wrangler reads .dev.vars, not .env).
# Production: npx wrangler secret put TELEGRAM_BOT_TOKEN --name bondautotransport
#             npx wrangler secret put TELEGRAM_CHAT_ID --name bondautotransport
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
